{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "nextjs", "import"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},
	"env": {
		"builtin": true,
		"browser": true,
		"es2024": true
	},
	"rules": {
		"react/react-in-jsx-scope": "off"
	},
	"ignorePatterns": [".next/**", "out/**", "build/**", "next-env.d.ts"]
}
